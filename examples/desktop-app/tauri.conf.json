{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeltaUpdaterExample",
  "version": "1.0.1",
  "identifier": "dev.chahdane.delta-updater-example",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "Delta Updater Example",
        "width": 520,
        "height": 360
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "http://127.0.0.1:0/manifest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCOTUyOUQzQUJCMzY4NzMKUldSemFMT3IweW1WMjRJNXFFajNpb2t0N3VkUS9TN1VJSkZmQ25FRldjcWNzRFh4bnZ3VXFBQWgK",
      "dangerousInsecureTransportProtocol": true
    }
  }
}
