use std::io::Write;

const BLOCK: usize = 512;
const COPY_CHUNK: usize = 8192; // std::io::copy's DEFAULT_BUF_SIZE

#[derive(Debug)]
struct Entry {
    header_at: usize,
    size: usize,
    typeflag: u8,
    name: String,
}

fn parse(tar: &[u8]) -> (Vec<Entry>, usize) {
    let mut entries = Vec::new();
    let mut at = 0usize;
    while at + BLOCK <= tar.len() {
        let header = &tar[at..at + BLOCK];
        if header.iter().all(|b| *b == 0) {
            break;
        }
        let size_field = std::str::from_utf8(&header[124..136]).unwrap_or("");
        let size = usize::from_str_radix(size_field.trim_end_matches(['\0', ' ']).trim(), 8)
            .unwrap_or(0);
        let typeflag = header[156];
        let name_end = header[..100].iter().position(|b| *b == 0).unwrap_or(100);
        let name = String::from_utf8_lossy(&header[..name_end]).into_owned();
        entries.push(Entry { header_at: at, size, typeflag, name });
        at += BLOCK + size.div_ceil(BLOCK) * BLOCK;
    }
    (entries, at)
}

/// Replay tar::Builder's write topology: one 512-byte header write, the payload
/// in std::io::copy-sized chunks, then one padding write. Trailer is one 1024
/// byte write, exactly as Builder::finish emits it.
fn topology_entry_aware<W: Write>(tar: &[u8], entries: &[Entry], trailer_at: usize, out: &mut W) {
    for e in entries {
        out.write_all(&tar[e.header_at..e.header_at + BLOCK]).unwrap();
        let payload = &tar[e.header_at + BLOCK..e.header_at + BLOCK + e.size];
        for chunk in payload.chunks(COPY_CHUNK) {
            out.write_all(chunk).unwrap();
        }
        let remaining = BLOCK - (e.size % BLOCK);
        if remaining < BLOCK {
            out.write_all(&vec![0u8; remaining]).unwrap();
        }
    }
    let _ = trailer_at;
    out.write_all(&[0u8; 1024]).unwrap();
}

fn topology_one_shot<W: Write>(tar: &[u8], out: &mut W) {
    out.write_all(tar).unwrap();
}

fn topology_uniform<W: Write>(tar: &[u8], out: &mut W) {
    for chunk in tar.chunks(COPY_CHUNK) {
        out.write_all(chunk).unwrap();
    }
}

fn gz(f: impl FnOnce(&mut flate2::write::GzEncoder<Vec<u8>>)) -> Vec<u8> {
    let mut enc = flate2::write::GzEncoder::new(Vec::new(), flate2::Compression::default());
    f(&mut enc);
    enc.finish().unwrap()
}

fn report(label: &str, got: &[u8], official: &[u8]) {
    let first_diff = got
        .iter()
        .zip(official.iter())
        .position(|(a, b)| a != b)
        .map(|i| i.to_string())
        .unwrap_or_else(|| {
            if got.len() == official.len() { "none".into() } else { format!("{}", got.len().min(official.len())) }
        });
    let exact = got.len() == official.len() && got == official;
    println!(
        "{label:24} len={:>9} official={:>9} first_diff={first_diff:>9} blake3={} {}",
        got.len(),
        official.len(),
        blake3::hash(got).to_hex(),
        if exact { "*** EXACT ***" } else { "" }
    );
}

fn main() {
    let tar_path = std::env::args().nth(1).expect("tar path");
    let official_path = std::env::args().nth(2).expect("official .tar.gz path");
    let tar = std::fs::read(&tar_path).unwrap();
    let official = std::fs::read(&official_path).unwrap();

    let (entries, trailer_at) = parse(&tar);
    println!("tar {} bytes, {} entries, trailer at {}", tar.len(), entries.len(), trailer_at);
    for e in &entries {
        println!("  type={} size={:>9} at={:>9}  {}", e.typeflag as char, e.size, e.header_at, e.name);
    }
    println!("trailer bytes after last entry: {}", tar.len() - trailer_at);
    println!("official blake3: {}", blake3::hash(&official).to_hex());
    println!();

    report("entry-aware", &gz(|e| topology_entry_aware(&tar, &entries, trailer_at, e)), &official);
    report("one-shot", &gz(|e| topology_one_shot(&tar, e)), &official);
    report("uniform-8192", &gz(|e| topology_uniform(&tar, e)), &official);
}

